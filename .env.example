# Supabase (server only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Protege o painel/API. Gere um valor longo e aleatório.
PRICE_TRACK_API_KEY=

# Chave AES-256: 32 bytes em base64 ou 64 caracteres hex.
CREDENTIAL_ENCRYPTION_KEY=

# Mercado Livre - aplicativo com PKCE habilitado
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/mercadolivre/callback

# URL pública do PriceTrack
APP_URL=https://SEU-DOMINIO.vercel.app

# Vercel Cron envia Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
